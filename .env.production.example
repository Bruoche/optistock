# Production (container) configuration — NON-SECRET values only.
# Copy to `.env.production` (gitignored) and adjust. Secrets are NOT here:
# APP_KEY, DB_PASSWORD, OPENSTREET_API_KEY and REVERB_APP_SECRET are injected at
# run time via Docker secrets + the *_FILE entrypoint shim (see docker/secrets/).

# --- Application ---
APP_NAME=Optistock
APP_ENV=production
APP_DEBUG=false
# Public, browser-facing base URL of the `web` ingress.
APP_URL=http://localhost:8080
# Host port the `web` (nginx) service publishes; APP_URL should match it.
HTTP_PORT=8080
# Stream logs to stderr so `docker logs` captures every service (D5/FR-014).
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (PostgreSQL — config-only switch, pdo_pgsql shipped in the image) ---
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=optistock
DB_USERNAME=optistock

# --- Session / queue / cache (database-backed — no extra broker) ---
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Broadcasting / Reverb websockets ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=optistock
# PUBLIC client key (also baked into the front-end assets as VITE_REVERB_APP_KEY).
REVERB_APP_KEY=optistock-key
# Internal Reverb host (server-side); the browser connects same-origin via nginx.
REVERB_HOST=websocket
REVERB_PORT=8080
REVERB_SCHEME=http

# --- OpenStreet TSP route-optimization API ---
OPENSTREET_API_URL=https://maps.open-street.com/api/tsp/
OPENSTREET_API_TIMEOUT=600
OPENSTREET_API_CONNECT_TIMEOUT=15
OPENSTREET_API_RETRIES=1
OPENSTREET_API_JOB_TIMEOUT=1260
OPENSTREET_ROUTE_URL=https://maps.open-street.com/api/route/
OPENSTREET_ROUTE_TIMEOUT=15
OPENSTREET_ROUTE_PRECISION=6
# Travel mode shared by the TSP optimization and route tracing.
OPENSTREET_MODE=trucking

# Queue worker must allow long jobs: retry_after > worker --timeout >= job timeout.
DB_QUEUE_RETRY_AFTER=1320
